# cp 후 파일명에서 .example 제거 (application-local.properties), 실제 값으로 채울 것.
# 이 파일 자체는 application.properties가 optional:classpath:application-local.properties로
# 불러오는 로컬 전용 오버라이드다 — 운영 값은 여기 쓰지 않는다(환경변수로 주입).
# bootRun·테스트는 이 파일과 classpath의 Firebase 키를 그대로 쓰지만, bootJar에는 둘 다 들어가지 않는다.
# 로컬에서 jar로 실행할 때는 FIREBASE_CREDENTIALS_LOCATION=file:/키경로 와 DB_URL·DB_PASSWORD·KOPIS_SERVICE_KEY 환경변수를 지정한다.

spring.datasource.url=jdbc:postgresql://localhost:5432/allargando
spring.datasource.username=postgres
spring.datasource.password=1234

# 로컬 편의 — 운영에서는 절대 금지 (CLAUDE.md 6장 참고)
spring.jpa.hibernate.ddl-auto=create
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.format_sql=true

# Expo web(브라우저)으로 로컬 연동 테스트할 때만 필요
app.cors.allowed-origins=http://localhost:8081

# KOPIS 오픈API — data.go.kr이 아니라 KOPIS 자체 사이트(kopis.or.kr)에서 발급받은 서비스키
kopis.service-key=발급받은키로교체
# 로컬에서 동기화를 바로 확인하고 싶을 때만 짧은 주기로 오버라이드(예: 매분 0초)
# kopis.sync.cron=0 * * * * *
# 동기화 수동 트리거(POST /api/concerts/sync) — 운영 기본값은 꺼짐
kopis.sync.manual-trigger-enabled=true

# Swagger(/swagger-ui/index.html) — 운영 기본값은 꺼짐
springdoc.api-docs.enabled=true
springdoc.swagger-ui.enabled=true
