# cp 후 파일명에서 .example 제거 (.env), test.sh가 자동으로 읽는다.

# Firebase 콘솔 → 프로젝트 설정 → 일반 → "웹 API 키"
# 별도로 웹 앱을 등록하지 않아도 프로젝트마다 기본으로 존재하는 값이다.
# 공개돼도 안전한 값(실제 방어선은 Firebase 보안 규칙)이지만, 프로젝트마다 값이 달라 팀원별로 채운다.
FIREBASE_API_KEY=

# Firebase Authentication 콘솔에서 이메일/비밀번호로 미리 만들어둔 테스트 계정.
# 값을 안 채우면 test.sh 기본값(test@test.com / test1234)을 그대로 쓴다.
EMAIL=test@test.com
PASSWORD=test1234
