# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
# Firebase 웹 API 키 등은 보통 .env에 들어가므로 함께 제외 (예시 파일은 허용)
.env
.env.*
!.env.example

# Firebase 모바일 설정 (/ios·/android 무시로 대부분 커버되나 명시적 방어선)
google-services.json
GoogleService-Info.plist

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android
