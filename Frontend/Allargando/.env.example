# 백엔드 API 베이스 URL
# 실기기 Expo Go에서는 localhost가 "폰 자기 자신"을 가리켜 백엔드에 붙지 않는다.
# 개발 머신의 LAN IP를 써야 한다 (ipconfig/ifconfig로 확인, 예: 192.168.0.12).
# 폰과 개발 머신이 같은 Wi-Fi에 있어야 하고, 방화벽에서 8080 인바운드가 열려 있어야 한다.
EXPO_PUBLIC_API_URL=http://192.168.0.2:8080

# 참고 — 실행 환경별 주소
#   실기기 Expo Go     http://<개발머신 LAN IP>:8080
#   iOS 시뮬레이터      http://localhost:8080
#   Android 에뮬레이터  http://10.0.2.2:8080

# Firebase 웹 앱 설정 (콘솔 → 프로젝트 설정 → 내 앱 → 웹 앱의 firebaseConfig)
# 앱 자체는 네이티브 Firebase SDK를 쓰고 설정을 빌드에 들어가는 google-services.json에서 읽으므로,
# 이 값들은 앱에서 쓰지 않는다. 터미널에서 도는 개발용 스크립트(scripts/register-test-user.mjs)가
# 웹 SDK로 로그인할 때만 필요하다. 이 스크립트를 쓰지 않으면 비워 두어도 앱은 동작한다.
# 이 값들은 클라이언트에 노출되는 공개 식별자이고, 실제 접근 제어는 Firebase 보안 규칙과
# 백엔드의 ID Token 검증이 담당한다.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# 이용약관·개인정보처리방침 공개 URL (Play 심사 조건). 비어 있으면 앱은 "준비 중" 안내만 띄운다.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# 주의: EXPO_PUBLIC_ 접두어가 붙은 값은 빌드 시 클라이언트 번들에 그대로 인라인된다.
# 절대 여기에 백엔드 전용 시크릿(서비스 계정 키 등)을 넣지 않는다 — 여긴 "공개돼도 되는" 값만.
